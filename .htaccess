# Activar módulo de reescritura
RewriteEngine On
RewriteBase /

# Regla para post individual: /blog/nombre-proyecto
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^blog/([a-z0-9-]+)/?$ articulo.php?slug=$1 [L,QSA]

# Regla para listado del blog: /blog
RewriteRule ^blog/?$ blog.php [L]

# Remover extensión .php de las URLs
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^([^\.]+)$ $1.php [NC,L]
